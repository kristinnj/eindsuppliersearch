{
    "name": "hlutir/eindsuppliersearch",
    "description": "Supplier search module for HLUTIR (PrestaShop 9.1).",
    "type": "prestashop-module",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "EindSupplierSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EindSupplierSearch\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "vendor-dir": "vendor-dev"
    }
}
